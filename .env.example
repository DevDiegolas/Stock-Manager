# Database
POSTGRES_USER=stockmanager
POSTGRES_PASSWORD=changeme
POSTGRES_DB=stockmanager
DATABASE_URL=postgres://stockmanager:changeme@db:5432/stockmanager?sslmode=disable

# JWT — REQUIRED. Generate a strong secret with: openssl rand -hex 32
# The backend refuses to start if this is empty or set to the example default.
JWT_SECRET=

# Server
SERVER_PORT=8080
UPLOAD_DIR=/data/uploads

# CORS — comma-separated list of allowed origins for the production frontend.
# When unset, defaults to localhost:3000 and localhost:5173 for development.
# ALLOWED_ORIGINS=https://seudominio.com

# Frontend
VITE_API_URL=/api/v1
